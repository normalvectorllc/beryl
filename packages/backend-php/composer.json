{
    "name": "beryl/backend-php",
    "description": "PHP backend for Beryl task management system",
    "type": "project",
    "require": {
        "php": "^8.0",
        "slim/slim": "^4.11",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^7.0",
        "monolog/monolog": "^3.0",
        "vlucas/phpdotenv": "^5.5",
        "illuminate/database": "^10.0",
        "respect/validation": "^2.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Beryl\\": "src/"
        }
    },
    "scripts": {
        "start": "php -S localhost:3001 -t public",
        "migrate": "php src/database/migrate.php",
        "seed": "php src/database/seed.php"
    }
}